{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lyrics-with-joyful-lips",
	"compatibility_date": "2026-08-22",
	"main": "./src/worker.js",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{ "pattern": "withjoyfullipslyrics.com", "custom_domain": true },
		{ "pattern": "www.withjoyfullipslyrics.com", "custom_domain": true }
	]
}
